# --- Sign-in (required) ---
# proxy: your internal system signs users in and forwards X-User-Email, X-User-Role (owner/member)
#        and X-Auth-Secret equal to AUTH_PROXY_SECRET. dev: everyone is an owner (local only).
AUTH_MODE=proxy
AUTH_PROXY_SECRET=change-me-to-a-long-random-string

# --- Claude (required for answers, gap checks and uploads) ---
ANTHROPIC_API_KEY=

# --- Email for the 3-day gap report (optional: without it reports are saved, not emailed) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=knowledge-center@your-company.com

# --- Uploading from links (optional: comma-separated hosts, subdomains included) ---
LINK_ALLOWED_HOSTS=wint.ai

# --- Other ---
PORT=3001
DATA_DIR=./data
# ALLOWED_ORIGINS=https://kc.internal.wint.ai
